generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ПОЛЬЗОВАТЕЛИ
// ============================================================
model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  password      String    @map("password_hash") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  // НОВЫЕ ПОЛЯ (добавлены) — настройки изучаемого языка и субтитров
  targetLang    String    @default("de") @map("target_lang") @db.VarChar(5)
  subtitleLines Int       @default(1) @map("subtitle_lines")

  // Пользовательские настройки Review Loop (Spec 2 доп., п.8 "калькулятор
  // повторений") — JSON-строка { intervals: [{maxPercent, days}], archivePercent,
  // archiveIntervalDays, dropOverrideThreshold, overrideMinDays, overrideMaxDays }.
  // null = используются дефолты из server/utils/reviewUtils.js.
  reviewSettings String?  @map("review_settings") @db.Text

  materials  Material[]
  folders    Folder[]
  vocab      Vocab[]

  @@map("users")
}

// ============================================================
// ПАПКИ
// ============================================================
model Folder {
  id        Int       @id @default(autoincrement())
  name      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId  Int?      @map("parent_id")
  parent    Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderToFolder")

  materials Material[]

  @@map("folders")
}

// ============================================================
// МАТЕРИАЛЫ (тексты / видео)
// ============================================================
model Material {
  id          Int       @id @default(autoincrement())
  title       String    @db.Text
  type        String    @db.VarChar(20)      // 'text' или 'video'
  youtubeUrl  String?   @map("youtube_url") @db.Text
  rawContent  String?   @map("raw_content") @db.Text
  icon        String?   @default("/icons/default.png")
  thumbnail   String?   @db.Text   
  importedAt  DateTime  @default(now()) @map("imported_at")
  folderId    Int?      @map("folder_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  subtitles   Subtitle[]
  vocab       Vocab[]
  wordSkips   MaterialWordSkip[]

  // НОВОЕ (Spec 2) — обратная связь на review loop, 1:1
  review      MaterialReview?

  // НОВЫЕ ПОЛЯ (добавлены)
  author      String?   @db.Text              // автор материала (необязательный)
  status      String    @default("new") @db.VarChar(20) // new, viewed, learning, completed
  language    String    @default("de") @db.VarChar(5)   // язык изучения материала (Spec 2 доп., п.9)

  @@map("texts")
}

// ============================================================
// СУБТИТРЫ
// ============================================================
model Subtitle {
  id        Int      @id @default(autoincrement())
  startMs   Int      @map("start_ms")
  endMs     Int      @map("end_ms")
  lineText  String?  @map("line_text") @db.Text
  lineIndex Int      @map("line_index")

  textId    Int      @map("text_id")
  material  Material @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@map("subtitles")
}

// ============================================================
// СЛОВАРЬ
// ============================================================
model Vocab {
  id              Int       @id @default(autoincrement())
  word            String    @db.Text
  translation     String?   @db.Text
  exampleSentence String?   @map("example_sentence") @db.Text
  status          String    @default("new") @db.VarChar(20)
  sourceTextId    Int?      @map("source_text_id")
  sourceSubtitleId Int?     @map("source_subtitle_id")
  sourceCustom    String?   @map("source_custom") @db.Text
  sentenceIndex   Int?      @map("sentence_index")
  wordIndices     String?   @map("word_indices") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material        Material? @relation(fields: [sourceTextId], references: [id], onDelete: SetNull)

  @@map("vocab")
}

// ============================================================
// SPEC 1: ПРОПУСК СЛОВА В КОНКРЕТНОМ МАТЕРИАЛЕ
// ============================================================
// Локальный оверрайд "не подсвечивать это слово в этом материале".
// Не трогает саму запись словаря (Vocab) и не влияет на слово в других
// материалах. Ключ — normalized word (а не vocabId), потому что New-слово
// ещё может не иметь записи в Vocab вообще (см. Spec 1: "New word skipped
// → not relevant to this text").
model MaterialWordSkip {
  id         Int      @id @default(autoincrement())
  word       String   @db.Text   // нормализованное слово (см. utils/normalizeWord.js)
  createdAt  DateTime @default(now()) @map("created_at")

  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, word])
  @@map("material_word_skips")
}

// ============================================================
// SPEC 2: REVIEW LOOP / SPACED REPETITION ДЛЯ МАТЕРИАЛОВ
// ============================================================
// Единица планирования — материал целиком (не отдельное слово).
// Наличие записи здесь = материал добавлен пользователем в Review loop.
// % known пересчитывается динамически при каждом проходе на основе
// текущего состояния Vocab (см. server/utils/reviewUtils.js), здесь же
// кэшируется последнее значение — нужно для "override" правила (просадка
// более чем на ~15 п.п. с прошлого раза форсирует короткий интервал).
model MaterialReview {
  id               Int       @id @default(autoincrement())
  materialId       Int       @unique @map("material_id")
  material         Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  lastPercentKnown Float?    @map("last_percent_known") // % known после последнего прохода (или сразу после добавления)
  nextReviewAt     DateTime? @map("next_review_at")      // null = ещё не назначено
  lastReviewedAt   DateTime? @map("last_reviewed_at")

  archived         Boolean   @default(false)
  archivedAt       DateTime? @map("archived_at")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("material_reviews")
}
