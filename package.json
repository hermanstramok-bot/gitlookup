{
  "name": "german-reader",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server\" \"npm run python\"",
    "client": "cd client && vite --host",
    "server": "cd server && node index.js",
    "build": "cd client && vite build",
    "python": "cd server/python && python -m uvicorn app:app --host 127.0.0.1 --port 8001"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "child_process": "1.0.2",
    "concurrently": "^8.2.0",
    "express": "^4.18.2",
    "framer-motion": "^12.40.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-youtube": "^10.1.0",
    "sql.js": "^1.8.0",
    "uuid": "^9.0.0",
    "vite": "^4.5.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
